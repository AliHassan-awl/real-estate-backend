generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}
enum Purpose {
  SALE
  RENT
}
enum PublicationStatus {
  DRAFT
  PUBLISHED
}
enum AvailabilityStatus {
  AVAILABLE
  PENDING
  SOLD
  RENTED
}
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VIEWING_SCHEDULED
  CLOSED_WON
  CLOSED_LOST
  SPAM
}
enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  CONVERTED
}
model AdminUser {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role Role @default(ADMIN)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Category {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  active Boolean @default(true)
  properties Property[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Location {
  id String @id @default(cuid())
  name String
  city String
  area String?
  slug String @unique
  active Boolean @default(true)
  properties Property[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Agent {
  id String @id @default(cuid())
  name String
  slug String @unique
  role String
  bio String
  email String @unique
  phone String
  whatsapp String
  photoUrl String?
  facebook String?
  instagram String?
  linkedin String?
  displayOrder Int @default(0)
  active Boolean @default(true)
  properties Property[]
  inquiries Inquiry[]
  viewingRequests ViewingRequest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Amenity {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  properties PropertyAmenity[]
}
model Property {
  id String @id @default(cuid())
  title String
  slug String @unique
  referenceId String @unique
  description String
  purpose Purpose
  price Decimal @db.Decimal(18, 2)
  oldPrice Decimal? @db.Decimal(18, 2)
  currency String @default("PKR")
  city String
  locality String?
  address String
  latitude Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  size Decimal @db.Decimal(12, 2)
  sizeUnit String @default("sq ft")
  bedrooms Int @default(0)
  bathrooms Int @default(0)
  garages Int @default(0)
  yearBuilt Int?
  videoTourUrl String?
  featured Boolean @default(false)
  publicationStatus PublicationStatus @default(DRAFT)
  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  seoTitle String?
  seoDescription String?
  categoryId String
  locationId String
  agentId String?
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  images PropertyImage[]
  amenities PropertyAmenity[]
  inquiries Inquiry[]
  viewingRequests ViewingRequest[]
  submission PropertySubmission? @relation("ConvertedProperty")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([purpose, publicationStatus, availabilityStatus])
  @@index([city, price])
}
model PropertyImage {
  id String @id @default(cuid())
  url String
  publicId String?
  altText String?
  isPrimary Boolean @default(false)
  sortOrder Int @default(0)
  propertyId String
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
model PropertyAmenity {
  propertyId String
  amenityId String
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Restrict)
  @@id([propertyId, amenityId])
}
model Inquiry {
  id String @id @default(cuid())
  name String
  email String
  phone String
  message String?
  status LeadStatus @default(NEW)
  adminNotes String?
  isRead Boolean @default(false)
  propertyId String?
  agentId String?
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}
model ViewingRequest {
  id String @id @default(cuid())
  name String
  email String
  phone String
  message String?
  preferredDate DateTime
  preferredTime String
  status LeadStatus @default(NEW)
  adminNotes String?
  isRead Boolean @default(false)
  propertyId String
  agentId String?
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ContactMessage {
  id String @id @default(cuid())
  name String
  email String
  phone String?
  subject String
  message String
  status LeadStatus @default(NEW)
  isRead Boolean @default(false)
  adminNotes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PropertySubmission {
  id String @id @default(cuid())
  ownerName String
  email String
  phone String
  whatsapp String
  purpose Purpose
  propertyType String
  title String
  city String
  address String
  expectedPrice Decimal @db.Decimal(18, 2)
  area Decimal @db.Decimal(12, 2)
  bedrooms Int @default(0)
  bathrooms Int @default(0)
  description String
  agreement Boolean
  status SubmissionStatus @default(PENDING)
  rejectionReason String?
  convertedPropertyId String? @unique
  convertedProperty Property? @relation("ConvertedProperty", fields: [convertedPropertyId], references: [id], onDelete: SetNull)
  images SubmissionImage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model SubmissionImage {
  id String @id @default(cuid())
  url String
  publicId String?
  submissionId String
  submission PropertySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}
model Testimonial {
  id String @id @default(cuid())
  name String
  role String?
  quote String
  rating Int @default(5)
  photoUrl String?
  active Boolean @default(true)
  displayOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model NewsletterSubscriber {
  id String @id @default(cuid())
  email String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
}
model SiteSetting {
  id String @id @default("main")
  agencyName String @default("EstateVista Properties")
  logoUrl String?
  faviconUrl String?
  primaryPhone String?
  whatsapp String?
  email String?
  officeAddress String?
  businessHours String?
  currency String @default("PKR")
  facebook String?
  instagram String?
  linkedin String?
  defaultSeoTitle String?
  defaultSeoDescription String?
  updatedAt DateTime @updatedAt
}
model HomepageSection {
  id String @id @default("main")
  heroHeading String
  heroDescription String
  heroBackgroundImage String?
  aboutTitle String?
  aboutContent String?
  footerText String?
  statistics Json?
  popularLocations Json?
  updatedAt DateTime @updatedAt
}
